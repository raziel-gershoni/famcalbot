// Prisma schema for FamCalBot
// Database: Neon (Serverless Postgres)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // Pooled connection for queries
  directUrl = env("DIRECT_URL")        // Direct connection for migrations
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id Int @id @default(autoincrement())

  // Platform identifiers
  telegramId    BigInt? @unique
  whatsappPhone String? @unique

  // Personal info
  name              String                              // Name in user's natural language
  englishName       String  @default("")                // English name for reference (was: hebrewName)
  gender            String                              // 'male' | 'female'

  // DEPRECATED: Spouse info now stored in calendar assignments
  // These will be removed in a future migration after data is migrated
  spouseName        String?                             // DEPRECATED
  spouseEnglishName String?                             // DEPRECATED (was: spouseHebrewName)
  spouseGender      String?                             // DEPRECATED

  // Settings
  location          String  @default("Harish, Israel")  // TODO: Change default to "" after migration
  culture           String  @default("default")         // 'jewish' | 'default'
  locationForced    Boolean @default(false)             // true = user confirmed their location
  globalRules       String[] @default([])               // Max 3 free-text rules for all calendars
  language          String  @default("Hebrew")
  messagingPlatform String  @default("telegram") // 'telegram' | 'whatsapp' | 'all'
  isAdmin           Boolean @default(false)       // Admin panel access

  // Calendar integration (shared token for now)
  googleRefreshToken  String   @db.Text
  calendarAssignments Json?    // Array of {calendarId, labels[], name, color}

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telegramId])
  @@index([whatsappPhone])
}

model OAuthState {
  id        String   @id @default(cuid())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}
