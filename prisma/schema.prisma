// Prisma schema for FamCalBot
// Database: Neon (Serverless Postgres)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Pooled connection for queries
  directUrl = env("DIRECT_URL") // Direct connection for migrations
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id Int @id @default(autoincrement())

  // Platform identifiers
  telegramId    BigInt? @unique
  whatsappPhone String? @unique // E.164 phone number (may be absent for username-only users)
  whatsappBsuid String? @unique // Business-Scoped User ID (June 2026+, replaces phone for username users)

  // Personal info
  name        String // Name in user's natural language
  englishName String @default("") // English name for reference
  gender      String // 'male' | 'female'

  // Settings
  location                   String    @default("") // User's location for weather/timezone
  culture                    String    @default("default") // 'jewish' | 'default'
  locationForced             Boolean   @default(false) // true = user confirmed their location
  globalRules                String[]  @default([]) // Max 3 free-text rules for all calendars
  language                   String    @default("he") // Locale code: 'he' | 'en' | 'ru'
  messagingPlatform          String    @default("telegram") // 'telegram' | 'whatsapp' | 'all'
  isAdmin                    Boolean   @default(false) // Admin panel access
  suspendedAt                DateTime? // Set = user suspended; bot ignores all interaction
  // Set when Telegram refuses delivery with 403 (user blocked the bot, deactivated
  // their account, or kicked the bot from a group). Distinct from BlockedIdentifier,
  // which is an admin ban - this is the user refusing us, not us refusing them.
  // Cleared automatically the next time we hear from them.
  unreachableSince           DateTime?
  suspendedBy                Int? // Admin User.id who suspended
  suspendedReason            String?   @db.Text // Why suspended (admin-facing audit)
  textSummaryEnabled         Boolean   @default(true) // Receive text summaries
  voiceSummaryEnabled        Boolean   @default(true) // Receive voice summaries
  voiceInputEnabled          Boolean   @default(false) // Allow voice message input for event creation
  voicePreference            String    @default("default") // TTS voice name (e.g. "Algieba") or "default"
  voiceStyle                 String    @default("natural") // TTS speaking style preset
  weatherEnabled             Boolean   @default(true) // Include weather in summaries
  includeWeeklyInLookahead   Boolean   @default(false) // Include weekly recurring in week lookahead
  includeLookaheadInTomorrow Boolean   @default(false) // Include week lookahead in tomorrow summary
  lookaheadAlways7Days       Boolean   @default(false) // true = always 7 days, false = until end of week
  preferredMorningHour       Int       @default(7) // 0-23, user's local time for daily summary
  preferredEveningHour       Int       @default(19) // 0-23, user's local time for tomorrow summary
  dailySummaryDays           Int[]     @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sun..6=Sat — which days to send morning summary
  tomorrowSummaryDays        Int[]     @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sun..6=Sat — which days to send evening summary
  remindersEnabled           Boolean   @default(false) // Enable event reminders via Telegram
  defaultReminderMinutes     Int? // Default reminder time (minutes before event)
  reminderTime               String? // HH:mm (15-minute step): when a reminder with no time of day pings. Null = 09:00
  pickupRemindersEnabled     Boolean   @default(true) // Enable pickup reminders for kids' events

  // Calendar integration
  calendarSource       CalendarSource @default(NATIVE) // GOOGLE for legacy GCal users, NATIVE for in-bot calendar
  googleRefreshToken   String         @db.Text // Empty string '' for NATIVE users (existing convention for pre-OAuth users)
  calendarAssignments  Json? // GOOGLE only — Array of CalendarAssignment: {calendarId, labels[], name, color, personName?, personEnglishName?, personGender?, rules?[]}
  googleScopes         String[]       @default([]) // The Google scopes granted, written when a token is committed; empty = calendar.app.created not granted
  googleSyncNotifiedAt DateTime? // The copy-to-Google reconnect message went out for the current outage (once per outage)

  // Pairing (NATIVE only — 1:1 partner)
  pairingId String?
  pairing   Pairing? @relation("UserPairing", fields: [pairingId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reminderStartAt DateTime? // When set, overrides createdAt for reminder scheduling

  // Relations
  subscription    Subscription?
  usageCounter    UsageCounter?
  activities      UserActivity[]
  featureOverride UserFeatureOverride?
  feedbacks       UserFeedback[]

  // Native calendar relations
  ownedNativeCalendars   NativeCalendar[]      @relation("OwnedNativeCalendars")
  createdNativeEvents    NativeEvent[]         @relation("CreatedNativeEvents")
  nativeRemindersFor     NativeEvent[]         @relation("NativeRemindersFor")
  nativeRemindersDone    NativeReminderState[] @relation("NativeRemindersDone")
  nativeReminderPings    NativeReminderPing[]
  pairingsInvited        Pairing[]             @relation("PairingsInvited")
  pairingsAccepted       Pairing[]             @relation("PairingsAccepted")
  pairingInvitesCreated  PairingInvite[]       @relation("PairingInvitesCreated")
  pairingInvitesAccepted PairingInvite[]       @relation("PairingInvitesAccepted")
  googleSyncLinks        GoogleSyncLink[]

  @@index([telegramId])
  @@index([whatsappPhone])
  @@index([whatsappBsuid])
  @@index([suspendedAt])
  @@index([unreachableSince])
  @@index([calendarSource])
  @@index([pairingId])
}

// Persistent blocklist for telegramId / whatsappPhone.
// Survives hard delete so banned identifiers cannot re-register.
model BlockedIdentifier {
  id            Int      @id @default(autoincrement())
  telegramId    BigInt?  @unique
  whatsappPhone String?  @unique
  bannedBy      Int // Admin User.id who banned
  bannedReason  String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([telegramId])
  @@index([whatsappPhone])
}

model OAuthState {
  id               String   @id @default(cuid())
  userId           BigInt
  token            String   @unique
  purpose          String? // null = connect; 'sync' = the first "Copy to Google", which also asks calendar.app.created
  nativeCalendarId String? // The FamCal calendar a 'sync' consent copies (no FK: the commit re-checks it is the user's own)
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([token])
  @@index([userId])
}

model AdminSettings {
  id                      String              @id @default("global")
  remindersEnabled        Boolean             @default(false)
  earlyAdoptionMode       Boolean             @default(true)
  // Unused: the AI and TTS models are fixed in src/config/ai-models.ts and
  // src/config/tts-models.ts. These three columns are kept only to avoid a migration.
  defaultAiModel          String?
  geminiThinkingLevel     String?
  ttsModel                String?
  voiceAutoCreateHighConf Boolean             @default(false) // Auto-create on HIGH-confidence voice CRUD (skip confirmation)
  voiceTtsOutcome         Boolean             @default(false) // Speak the outcome line back when input was voice
  nativeRemindersEnabled  Boolean             @default(true) // Built-in calendar reminders: the extraction rules and the 1-minute ping pass
  calendarHomeRollout     CalendarHomeRollout @default(OFF) // No longer read: the calendar home and the summary reader are on for everyone. Kept to avoid a migration
  updatedAt               DateTime            @updatedAt
}

// No longer read (the switch was set to ALL and its code removed); kept with its column to avoid a migration
enum CalendarHomeRollout {
  OFF // The column's default
  ADMINS // Users with isAdmin only
  ALL // Everyone
}

// ============================================
// NATIVE CALENDAR + PAIRING
// ============================================

enum CalendarSource {
  GOOGLE // Legacy Google Calendar OAuth users
  NATIVE // In-bot native calendar users
}

enum NativeCalendarPrivacy {
  PRIVATE // Owner only (even when paired)
  SHARED_VIEWER // Partner can view + receive reminders, not edit
  SHARED_EDITOR // Partner can view + edit + receive reminders
}

enum PairingStatus {
  PENDING // Invite sent, not yet accepted
  ACTIVE // Both members linked
  UNLINKED // Was active, has been broken; row kept for audit
}

enum NativeEventInstanceStatus {
  OVERRIDE // This occurrence has modified fields (rescheduled, retitled, etc.)
  CANCELLED // This occurrence is removed (alternative to series-level exdates)
}

enum NativeEventKind {
  EVENT // Has a duration (every event before reminders)
  REMINDER // No duration: endsAt = startsAt; all-day = start of its local day
}

model NativeCalendar {
  id                String                @id @default(cuid())
  ownerUserId       Int
  owner             User                  @relation("OwnedNativeCalendars", fields: [ownerUserId], references: [id], onDelete: Restrict)
  name              String
  color             String                @default("#039BE5") // Fixed palette in v1
  labels            String[]              @default([]) // Reuses label vocab: primary | yours | spouse | kids | birthdays
  personName        String? // Mirror of CalendarAssignment for kid/spouse calendars
  personEnglishName String?
  personGender      String?
  rules             String[]              @default([]) // Free-text rules (max 1, 200 chars each)
  privacy           NativeCalendarPrivacy @default(PRIVATE)
  isDeleted         Boolean               @default(false) // Soft delete to preserve event history
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  events          NativeEvent[]
  googleSyncLinks GoogleSyncLink[]

  @@index([ownerUserId])
  @@index([ownerUserId, privacy])
  @@index([ownerUserId, isDeleted])
}

model NativeEvent {
  id              String          @id @default(cuid())
  calendarId      String
  calendar        NativeCalendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creatorUserId   Int
  creator         User            @relation("CreatedNativeEvents", fields: [creatorUserId], references: [id], onDelete: Restrict)
  title           String
  description     String?         @db.Text
  location        String?
  startsAt        DateTime // For recurring: dtstart
  endsAt          DateTime
  allDay          Boolean         @default(false)
  timeZone        String // IANA tz, snapshot at creation
  rrule           String? // RFC-5545 RRULE on series; null = single event
  hebrewRule      String? // 'anniversary', the one kind: the series follows its anchor's Hebrew date (rrule is then FREQ=YEARLY with at most INTERVAL, UNTIL or COUNT)
  hebrewAnchor    String? // 'yyyy-MM-dd': the anchor's civil date in timeZone; set exactly when hebrewRule is
  exdates         DateTime[]      @default([]) // Cancelled instance start times (UTC)
  ownAlerts       Boolean         @default(false) // false = the user's default lead; true = alertMinutes (empty = no alert)
  alertMinutes    Int[]           @default([]) // Lead times in minutes before the start (0 = at start); one per event in the editor
  kind            NativeEventKind @default(EVENT)
  forUserId       Int? // REMINDER target; null = the creator. Meaningful only for REMINDER
  forUser         User?           @relation("NativeRemindersFor", fields: [forUserId], references: [id], onDelete: SetNull)
  forBoth         Boolean         @default(false) // REMINDER for both partners: forUserId is then the partner, and the recipients are the creator and that partner
  armedAt         DateTime? // REMINDER: when its time was last set (create or time change); bounds the ping lookback
  isDeleted       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  instances NativeEventInstance[]
  states    NativeReminderState[]

  @@index([calendarId, startsAt])
  @@index([calendarId, isDeleted])
  @@index([creatorUserId])
  @@index([kind, isDeleted, startsAt])
  @@index([forUserId])
}

model NativeEventInstance {
  id               String                    @id @default(cuid())
  seriesEventId    String
  seriesEvent      NativeEvent               @relation(fields: [seriesEventId], references: [id], onDelete: Cascade)
  originalStartsAt DateTime // recurrence-id (which instance this overrides)
  status           NativeEventInstanceStatus
  title            String? // null = inherit from series
  description      String?                   @db.Text
  location         String?
  startsAt         DateTime?
  endsAt           DateTime?
  allDay           Boolean?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([seriesEventId, originalStartsAt])
  @@index([seriesEventId, originalStartsAt])
}

// Per-occurrence state of a REMINDER, keyed like NativeEventInstance. No row means
// pending; a row appears once the occurrence is pinged, snoozed or marked done. Done is
// shared by everyone the reminder is for; each recipient's own ping is a NativeReminderPing.
// (The table still has the old ping columns snoozedUntil, lastPingedAt, pingAttempts,
// pingChatId, pingMessageId and their index: they left this schema in the "remind us both"
// release and a later migration drops them.)
model NativeReminderState {
  id               String               @id @default(cuid())
  seriesEventId    String
  seriesEvent      NativeEvent          @relation(fields: [seriesEventId], references: [id], onDelete: Cascade)
  originalStartsAt DateTime // occurrence key, exactly expandSeries' instanceStartsAt (one-off: startsAt)
  doneAt           DateTime?
  doneByUserId     Int?
  doneBy           User?                @relation("NativeRemindersDone", fields: [doneByUserId], references: [id], onDelete: SetNull)
  pings            NativeReminderPing[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([seriesEventId, originalStartsAt])
}

// One recipient's ping of one occurrence: its snooze, the claim that stops a second send,
// and the live Telegram message, so a Done or a move can edit it. A single reminder has one
// row per occurrence, a reminder for both partners two.
model NativeReminderPing {
  id            String              @id @default(cuid())
  stateId       String
  state         NativeReminderState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  userId        Int
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snoozedUntil  DateTime?
  lastPingedAt  DateTime?
  pingAttempts  Int                 @default(0)
  pingChatId    BigInt? // the live ping message, so later edits can strip its buttons
  pingMessageId Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([stateId, userId])
  @@index([snoozedUntil])
}

// ============================================
// FAMCAL → GOOGLE ONE-WAY SYNC
// (docs/superpowers/specs/2026-10-20-google-sync-design.md §2)
// ============================================

// One own FamCal calendar copied into its own "FamCal · <name>" Google calendar. Kept
// after Keep or Remove (enabled = false), so a re-enable reuses the Google calendar and
// FamCal never shows that calendar back in its reads.
model GoogleSyncLink {
  id               String          @id @default(cuid())
  userId           Int
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nativeCalendarId String?
  nativeCalendar   NativeCalendar? @relation(fields: [nativeCalendarId], references: [id], onDelete: SetNull)
  googleCalendarId String? // Set once calendars.insert answered (or the 'creating' retry adopted it)
  googleAccount    String? // The Google account's `sub` the copy lives in
  enabled          Boolean         @default(true)
  state            String          @default("creating") // 'creating' | 'ok' | 'token' | 'scopes' | 'gone' | 'otherAccount' | 'plan' | 'error'
  unlinkChoice     String? // 'remove' | 'keep': what turning the copy off asked for, carried out by the worker
  unlinkToken      String?         @db.Text // Encrypted refresh token of a merged-away user whose token stayed behind: only the queued Remove/Keep uses it, then clears it
  dirtySeq         Int             @default(0) // +1 on a link-level change (rename, turned off) in the write's transaction
  pushedSeq        Int             @default(0) // The dirtySeq the worker last carried out; clean when equal
  pushedName       String? // The calendar name last sent to Google
  lastError        String?         @db.Text
  lastSyncedAt     DateTime?
  backfilledAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items GoogleSyncItem[]

  @@unique([userId, nativeCalendarId])
  @@index([nativeCalendarId, enabled])
}

// One FamCal series as copied into a link's Google calendar. nativeEventId is a plain
// column (no foreign key), so the series can vanish under it and the worker still
// deletes the copy.
model GoogleSyncItem {
  id            String         @id @default(cuid())
  linkId        String
  link          GoogleSyncLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  nativeEventId String
  googleEventId String?
  generation    Int            @default(0) // +1 on each delete-and-reinsert; part of the deterministic event id
  masterHash    String?
  slotHashes    Json           @default("{}") // One hash per override or cancelled slot
  dirtySeq      Int            @default(0) // +1 on every write to the series, in the write's transaction
  pushedSeq     Int            @default(0) // The dirtySeq the last push read; clean only when equal
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  status        String         @default("ok") // 'ok' | 'unsupported' | 'error'
  lastError     String?        @db.Text

  @@unique([linkId, nativeEventId])
}

model Pairing {
  id               String        @id @default(cuid())
  status           PairingStatus
  inviterUserId    Int
  inviter          User          @relation("PairingsInvited", fields: [inviterUserId], references: [id], onDelete: Restrict)
  inviteeUserId    Int?
  invitee          User?         @relation("PairingsAccepted", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())
  acceptedAt       DateTime?
  unlinkedAt       DateTime?
  unlinkedByUserId Int?

  members User[] @relation("UserPairing") // Both partners point here via User.pairingId

  @@index([inviterUserId])
  @@index([inviteeUserId])
  @@index([status])
}

model PairingInvite {
  id               String    @id @default(cuid())
  token            String    @unique
  inviterUserId    Int
  inviter          User      @relation("PairingInvitesCreated", fields: [inviterUserId], references: [id], onDelete: Cascade)
  expiresAt        DateTime // now + 7 days
  acceptedAt       DateTime?
  acceptedByUserId Int?
  acceptedBy       User?     @relation("PairingInvitesAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([token])
  @@index([inviterUserId])
  @@index([expiresAt])
}

// ============================================
// SUBSCRIPTION & USAGE TRACKING
// ============================================

enum SubscriptionStatus {
  TRIALING // 14-day trial active
  ACTIVE // Paid and active
  CANCELED // Will expire at period end
  EXPIRED // Trial/subscription ended
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

model Subscription {
  id     String @id @default(cuid())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(TRIALING)

  // Telegram Stars subscription
  telegramPaymentChargeId String? // From successful_payment

  // Trial tracking
  trialStartedAt DateTime @default(now())
  trialEndsAt    DateTime // trialStartedAt + 14 days

  // Paid subscription tracking
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Admin-granted ("comped") access. compedBy IS NULL means this is a real
  // subscription; non-null means an admin gave it away for free. A comped row
  // has currentPeriodEnd = NULL so the expiry cron can never match it.
  compedBy   Int? // admin User.id who granted it
  compedAt   DateTime?
  compReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model UsageCounter {
  id     String @id @default(cuid())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])

  textSummariesUsed  Int @default(0)
  voiceSummariesUsed Int @default(0)
  voiceEventsCreated Int @default(0)
  remindersTriggered Int @default(0)

  cycleStartDate DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// User activity logging for analytics
model UserActivity {
  id     String @id @default(cuid())
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  action   String // 'text_summary', 'voice_summary', 'reminder_sent', etc.
  metadata Json? // Additional context (calendar count, language, etc.)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// Admin-granted feature overrides for individual users
model UserFeatureOverride {
  id     String @id @default(cuid())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])

  // Admin-granted features (null = no override, use subscription)
  unlimitedSummaries Boolean? // Bypass text/voice summary limits
  remindersEnabled   Boolean? // Grant reminders access
  voiceEventsEnabled Boolean? // Grant voice event creation
  unlimitedCalendars Boolean? // Bypass calendar limit
  earlyAdopter       Boolean  @default(false)

  // Metadata
  grantedBy Int? // Admin user ID who granted
  grantedAt DateTime?
  reason    String? // Why override was granted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// User feedback submissions
model UserFeedback {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  text      String   @db.Text
  source    String   @default("telegram") // "telegram" or "dashboard"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
