# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Webhook secret for validating incoming requests (set this in BotFather)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
# The bot's username, without @, for t.me links (unset: the public FamCal bot)
# TELEGRAM_BOT_USERNAME=your_bot_username_here

# WhatsApp Business API Configuration (optional)
# Get from: https://developers.facebook.com/apps - WhatsApp Business API
# Tutorial: See README.md for complete setup instructions
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_secret_token_here
# The business number, digits only with the country code, for wa.me links (unset: the public FamCal number)
# WHATSAPP_PHONE_NUMBER=your_whatsapp_number_here
# App secret (Meta app dashboard > App settings > Basic); verifies webhook signatures
# WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here

# Google Calendar API Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# AI Provider Configuration
# The models are fixed in src/config/ai-models.ts and src/config/tts-models.ts (both Gemini).

# API Keys (the fixed models need only GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override max output tokens (defaults to model's maxOutputTokens)
# AI_MAX_TOKENS=8192

# Optional: Configure retry attempts for API failures (default: 1, i.e. 2 total attempts)
# AI_MAX_RETRIES=1

# Cron Job Secret (for internal server auth - execute-command, usage endpoints)
CRON_SECRET=your_secret_token_here

# Required, no fallback: a random value of its own (openssl rand -hex 32). The WhatsApp
# session cookie and the share-story image links are signed with keys derived from it;
# unset, both are refused.
# SESSION_SECRET=your_random_session_secret_here

# Encrypts the stored Google tokens: 64 hex characters (openssl rand -hex 32). Never
# replace it without setting ENCRYPTION_KEY_PREVIOUS (README: Rotating ENCRYPTION_KEY).
# ENCRYPTION_KEY=your_encryption_key_here
# Decrypt-only: the old ENCRYPTION_KEY while a rotation runs; delete it once the key sweep logs SAFE
# ENCRYPTION_KEY_PREVIOUS=your_old_encryption_key_here

# QStash (Upstash) for scheduled job triggering
# Get from https://console.upstash.com/qstash
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key_here

# Redis (Upstash) for distributed locking and caching
# Get from https://console.upstash.com/ - Free tier: 500K commands/month
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Optional: Voice Messages (Gemini TTS)
# Uses GEMINI_API_KEY (configured above) for voice generation. The host voices are
# Gemini built-in voices, fixed per language in src/services/voice-generator.ts.

# Sentry Error Tracking (optional but recommended for production)
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your_key@sentry.io/your_project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project_id
SENTRY_ORG=your_org_slug
SENTRY_PROJECT=your_project_slug

# Environment
NODE_ENV=development
