{
  "name": "famcalbot",
  "version": "1.0.0",
  "description": "Family Calendar Telegram Bot with Google Calendar and Claude AI",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:next": "next dev",
    "dev:bot": "tsx src/index.ts",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "type-check": "tsc --noEmit",
    "get-google-token": "tsx scripts/get-google-token.ts",
    "setup-webhook": "tsx scripts/setup-webhook.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "calendar",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/genai": "^1.42.0",
    "@hebcal/core": "^6.0.6",
    "@hebcal/locales": "^6.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@prisma/client": "^5.22.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nextjs": "^10.32.1",
    "@swc/helpers": "^0.5.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "bidi-js": "^1.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "googleapis": "^164.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "next-intl": "^4.6.1",
    "next-mdx-remote": "^6.0.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^6.9.1",
    "opusscript": "^0.1.1",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
