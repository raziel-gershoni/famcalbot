{
  "name": "famcalbot",
  "version": "1.0.0",
  "description": "Family Calendar Telegram Bot with Google Calendar and Gemini AI",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "lint": "eslint .",
    "start": "NODE_OPTIONS='--max-old-space-size=256' next start",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "type-check": "tsc --noEmit",
    "get-google-token": "tsx scripts/get-google-token.ts",
    "setup-webhook": "tsx scripts/setup-webhook.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "calendar",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@google/genai": "^1.52.0",
    "@googleapis/calendar": "^9.8.0",
    "@hebcal/core": "^6.16.0",
    "@hebcal/hdate": "^0.23.1",
    "@hebcal/locales": "^6.5.3",
    "@ncdai/react-wheel-picker": "1.2.3",
    "@openmeteo/file-reader": "0.0.21",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nextjs": "^10.78.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/culori": "^4.0.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "bidi-js": "^1.1.0",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "geo-tz": "^8.1.11",
    "gray-matter": "^4.0.3",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.10",
    "next-mdx-remote": "^6.0.0",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "2.4.0",
    "openid-client": "6.8.9",
    "opusscript": "^0.1.1",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "postcss": "^8.5.32",
    "prisma": "7.10.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrule": "^2.8.1",
    "satori": "^0.25.0",
    "tailwindcss": "^4.3.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "geotiff": "^3.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "form-data": "^4.0.4",
    "tough-cookie": "^6.0.0",
    "esbuild": "^0.25.12",
    "path-to-regexp": "^8.3.0",
    "undici": "^7.16.0"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.5.1"
  }
}
